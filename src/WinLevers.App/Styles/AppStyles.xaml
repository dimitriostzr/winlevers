<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Desktop-dense type ramp, matching the sibling windows-* apps: page titles
    20px, section headers 13px, body 13px, captions 12/11px. The stock
    TitleTextBlockStyle is 28px and reads as oversized in a tool like this.
  -->

  <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="SidebarHeaderTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>

  <Style x:Key="TableHeaderTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="RowPrimaryTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="RowSecondaryTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="CardBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <!--
    State colours. Five states appear at high density in the grid, which is
    exactly where colour-only encoding fails, so every badge also carries a
    glyph and a word — see StateBadge. These brushes are the third channel,
    never the only one.

    The fills and the alternate-row shade are translucent overlays: one
    definition reads correctly on both the light and the dark surface, and the
    ListView's own hover highlight shows through them. Only the text brushes
    need a value per theme, and those are resolved by the window's actual
    theme — see ThemeBrushes — because the theme is switched on the window's
    root, not on the application.
  -->
  <SolidColorBrush x:Key="StatePositiveFillBrush" Color="#3838B24A" />
  <SolidColorBrush x:Key="StateNegativeFillBrush" Color="#3DE0402F" />
  <SolidColorBrush x:Key="StateCautionFillBrush" Color="#38E0A000" />
  <SolidColorBrush x:Key="StateNeutralFillBrush" Color="#383A8DDE" />
  <SolidColorBrush x:Key="StateMutedFillBrush" Color="#26808080" />
  <SolidColorBrush x:Key="RowAlternateBrush" Color="#14808080" />

  <!-- Hover and pressed feedback for table rows, drawn by the item presenter
       beneath the shades above, so it has to be strong enough to read through
       the denied tint. -->
  <SolidColorBrush x:Key="RowHoverBrush" Color="#40808080" />
  <SolidColorBrush x:Key="RowPressedBrush" Color="#30808080" />

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="StatePositiveBrush" Color="#0F7B0F" />
      <SolidColorBrush x:Key="StateNegativeBrush" Color="#C42B1C" />
      <SolidColorBrush x:Key="StateCautionBrush" Color="#9D5D00" />
      <SolidColorBrush x:Key="StateNeutralBrush" Color="#005FB8" />
      <SolidColorBrush x:Key="StateMutedBrush" Color="#5D5D5D" />
    </ResourceDictionary>
    <!-- "Default" is the dark dictionary's canonical key. -->
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="StatePositiveBrush" Color="#6CCB5F" />
      <SolidColorBrush x:Key="StateNegativeBrush" Color="#FF99A4" />
      <SolidColorBrush x:Key="StateCautionBrush" Color="#FCE100" />
      <SolidColorBrush x:Key="StateNeutralBrush" Color="#60CDFF" />
      <SolidColorBrush x:Key="StateMutedBrush" Color="#A0A0A0" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
