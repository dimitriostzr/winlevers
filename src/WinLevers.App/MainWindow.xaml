<Window
    x:Class="WinLevers.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:WinLevers.App.Services"
    xmlns:views="using:WinLevers.App.Views"
    xmlns:vm="using:WinLevers.Presentation.ViewModels">

  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="RootGrid">
    <Grid.Resources>
      <services:StringToVisibilityConverter x:Key="TextVisible" />
    </Grid.Resources>

    <Grid.RowDefinitions>
      <RowDefinition Height="36" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Custom title bar -->
    <Grid x:Name="AppTitleBar" Padding="16,0">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <!-- Decoded at its drawn size, scaled for the display, rather than
             letting the compositor shrink the 256 px source sixteenfold. -->
        <Image Width="16" Height="16" VerticalAlignment="Center">
          <Image.Source>
            <BitmapImage UriSource="ms-appx:///Assets/WinLevers.png"
                         DecodePixelWidth="16" DecodePixelType="Logical" />
          </Image.Source>
        </Image>
        <TextBlock Text="WinLevers" Style="{StaticResource CaptionTextBlockStyle}"
                   VerticalAlignment="Center" />
        <!-- Elevation is stated, never assumed. A user has to be able to see
             why machine-scope levers are inert. -->
        <TextBlock x:Name="ElevationNote" Text="· administrator"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   VerticalAlignment="Center" Visibility="Collapsed" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!--
        Left: the lenses. Every lever row carries live counts, which is the
        design's answer to "which apps are in which state" — there is no
        separate overview screen because this is it.
      -->
      <Grid Padding="8,4,4,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6" Margin="4,4,4,8">
          <Button x:Name="RescanButton" Click="Rescan_Click"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="32">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE72C;" FontSize="13" />
              <TextBlock Text="Rescan machine" FontSize="13" />
            </StackPanel>
          </Button>

          <!-- Narrows the lever entries only; the fixed entries always stay. -->
          <TextBox x:Name="LensSearchBox" Height="32" PlaceholderText="Find a setting"
                   Text="{x:Bind ViewModel.LensSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <ListView Grid.Row="1"
                  x:Name="LensList"
                  ItemsSource="{x:Bind ViewModel.VisibleLenses, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedLens, Mode=OneWay}"
                  SelectionChanged="LensList_SelectionChanged"
                  SelectionMode="Single">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="10,6" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:LensViewModel">
              <StackPanel Spacing="1">
                <!-- Group header, present only on the first lever of a group.
                     Binding for the converter, for the same reason as below. -->
                <TextBlock Text="{x:Bind GroupTitle}" Style="{StaticResource SidebarHeaderTextStyle}"
                           Margin="0,6,0,4"
                           Visibility="{Binding GroupTitle, Converter={StaticResource TextVisible}}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <StackPanel Spacing="1">
                    <TextBlock Text="{x:Bind Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <!--
                      Binding rather than x:Bind, and only for the converter. A
                      compiled binding that names a converter makes the generator
                      emit SetConverterLookupRoot(FrameworkElement), which it hands
                      the XAML root — and this file's root is a Window, which is not
                      a FrameworkElement. The same converter is fine under x:Bind in
                      the UserControl views, because those roots are.
                    -->
                    <TextBlock Text="{x:Bind CountSummary, Mode=OneWay}"
                               Style="{StaticResource RowSecondaryTextStyle}"
                               Visibility="{Binding CountSummary, Converter={StaticResource TextVisible}}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>

      <!-- Right: whichever view the active lens asks for -->
      <Border Grid.Column="1"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1,1,0,0"
              CornerRadius="8,0,0,0">
        <Grid>
          <views:DashboardView x:Name="DashboardView" Visibility="Collapsed" />
          <views:PrivacyView x:Name="PrivacyView" Visibility="Collapsed" />
          <views:AppsView x:Name="AppsView" />
          <views:HistoryView x:Name="HistoryView" Visibility="Collapsed" />
          <views:SettingsView x:Name="SettingsView" Visibility="Collapsed" />
          <views:AboutView x:Name="AboutView" Visibility="Collapsed" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
