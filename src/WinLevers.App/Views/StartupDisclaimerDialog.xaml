<ContentDialog
    x:Class="WinLevers.App.Views.StartupDisclaimerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Use at your own risk"
    PrimaryButtonText="I accept — continue"
    CloseButtonText="Exit"
    DefaultButton="Close"
    IsPrimaryButtonEnabled="False">

  <ContentDialog.Resources>
    <!-- The stock dialog caps its content at 548px, which wraps this text into
         a column too narrow to read. Lightweight styling keys the dialog
         template reads; raising them here affects this dialog only. -->
    <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
    <x:Double x:Key="ContentDialogMaxHeight">860</x:Double>
  </ContentDialog.Resources>

  <Grid Width="600" MaxHeight="560">
    <ScrollViewer>
      <StackPanel Spacing="14">

        <TextBlock Style="{StaticResource RowPrimaryTextStyle}" TextWrapping="Wrap"
                   Text="WinLevers edits the Windows registry. It writes only per-user values under HKCU — the same ones the Windows Settings app edits — and it writes nothing until you have previewed and confirmed the exact list. Even so, changing app permissions and graphics preferences in bulk can stop applications working the way you expect." />

        <Border Style="{StaticResource CardBorderStyle}">
          <StackPanel Spacing="8">
            <TextBlock Text="Take a full system restore point first"
                       Style="{StaticResource SectionHeaderTextStyle}" />
            <TextBlock Style="{StaticResource RowSecondaryTextStyle}" TextWrapping="Wrap"
                       Text="Before your first batch, create a full System Restore point so the whole machine can be rolled back if something goes wrong. WinLevers journals every write and can put individual changes back, but a restore point is the wider safety net it cannot provide." />
            <TextBlock Style="{StaticResource RowSecondaryTextStyle}" TextWrapping="Wrap"
                       Text="The button below opens the Windows System Protection page, where Create… makes the restore point. WinLevers does not create one for you, and cannot: that is a machine-wide operation and this app writes nothing machine-wide." />
            <Button x:Name="RestorePointButton" Content="Open System Protection"
                    Click="OpenRestorePoint_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="RestorePointError" Style="{StaticResource RowSecondaryTextStyle}"
                       TextWrapping="Wrap" Visibility="Collapsed"
                       Text="Windows would not open that page. Open Start and search for &quot;Create a restore point&quot;." />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}">
          <StackPanel Spacing="8">
            <TextBlock Text="No warranty, no support"
                       Style="{StaticResource SectionHeaderTextStyle}" />
            <TextBlock Style="{StaticResource RowSecondaryTextStyle}" TextWrapping="Wrap"
                       Text="WinLevers is a personal project, free and open source under the MIT licence. It is provided as is, without warranty of any kind, express or implied. You use it entirely at your own risk, and the author accepts no liability for any loss or damage arising from its use. It is unmaintained and there is no support channel." />
            <TextBlock Style="{StaticResource RowSecondaryTextStyle}" TextWrapping="Wrap"
                       Text="Not affiliated with, endorsed by or supported by Microsoft. Windows and Microsoft are trademarks of Microsoft Corporation; all other product names are trademarks of their respective owners." />
          </StackPanel>
        </Border>

        <!-- The gate. Unticked, the primary button stays disabled, and every
             other way out of this dialog exits the app. -->
        <CheckBox x:Name="AcceptCheck"
                  Checked="Accept_Changed" Unchecked="Accept_Changed">
          <TextBlock TextWrapping="Wrap"
                     Text="I have read this. I understand that WinLevers changes my registry, that it comes with no warranty or support, and that I use it at my own risk." />
        </CheckBox>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</ContentDialog>
