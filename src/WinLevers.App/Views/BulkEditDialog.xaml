<ContentDialog
    x:Class="WinLevers.App.Views.BulkEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinLevers.Presentation.ViewModels"
    Title="Edit settings"
    PrimaryButtonText="Preview changes"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

  <ContentDialog.Resources>
    <!-- The stock dialog caps its content at 548px, which clipped the combo
         column off the right edge. These are the lightweight styling keys the
         dialog template reads; raising them here affects this dialog only. -->
    <x:Double x:Key="ContentDialogMaxWidth">840</x:Double>
    <x:Double x:Key="ContentDialogMaxHeight">920</x:Double>
  </ContentDialog.Resources>

  <Grid Width="700" MaxHeight="520">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="Intro" Style="{StaticResource RowSecondaryTextStyle}" Margin="0,0,0,12"
               TextWrapping="Wrap" />

    <!-- Every lever, each defaulting to "Leave unchanged". A panel that
         defaulted to a value would rewrite settings nobody looked at. -->
    <ScrollViewer Grid.Row="1">
      <ItemsControl ItemsSource="{x:Bind Panel.Levers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LeverTargetViewModel">
            <Grid Padding="0,6" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
              </Grid.ColumnDefinitions>

              <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource RowPrimaryTextStyle}" />
                <TextBlock Text="{x:Bind ReachText}" Style="{StaticResource RowSecondaryTextStyle}" />
              </StackPanel>

              <ComboBox Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{x:Bind IsTargetable}"
                        ItemsSource="{x:Bind ChoicesWithUnchanged}"
                        SelectedItem="{x:Bind SelectedChoice, Mode=TwoWay}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</ContentDialog>
