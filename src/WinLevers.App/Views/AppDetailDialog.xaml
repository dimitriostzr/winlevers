<ContentDialog
    x:Class="WinLevers.App.Views.AppDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:WinLevers.App.Services"
    xmlns:vm="using:WinLevers.Presentation.ViewModels"
    PrimaryButtonText="Preview changes"
    CloseButtonText="Close"
    DefaultButton="Close">

  <ContentDialog.Resources>
    <services:StateToneToBrushConverter x:Key="ToneBrush" />
    <services:BoolToVisibilityConverter x:Key="BoolVisible" />
    <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
    <x:Double x:Key="ContentDialogMaxHeight">920</x:Double>
  </ContentDialog.Resources>

  <Grid Width="780" MaxHeight="640">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- What the app is -->
    <StackPanel Spacing="3" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{x:Bind ViewModel.DisplayName}" Style="{StaticResource PageTitleTextStyle}" />
        <Border Visibility="{x:Bind ViewModel.IsSystemComponent, Converter={StaticResource BoolVisible}}"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
          <TextBlock Text="Windows component" FontSize="11"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Border>
      </StackPanel>
      <TextBlock Style="{StaticResource RowSecondaryTextStyle}">
        <Run Text="{x:Bind ViewModel.TypeLabel}" /><Run Text=" · " /><Run Text="{x:Bind ViewModel.Publisher}" />
      </TextBlock>
      <TextBlock Text="{x:Bind ViewModel.PathText}" FontSize="12" IsTextSelectionEnabled="True"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
    </StackPanel>

    <!-- Column headers -->
    <Grid Grid.Row="1" Padding="0,0,0,6" ColumnSpacing="12" BorderThickness="0,0,0,1"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="150" />
        <ColumnDefinition Width="90" />
        <ColumnDefinition Width="200" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="SETTING" Style="{StaticResource TableHeaderTextStyle}" />
      <TextBlock Grid.Column="1" Text="NOW" Style="{StaticResource TableHeaderTextStyle}" />
      <TextBlock Grid.Column="2" Text="LAST USED" Style="{StaticResource TableHeaderTextStyle}" />
      <TextBlock Grid.Column="3" Text="CHANGE TO" Style="{StaticResource TableHeaderTextStyle}" />
    </Grid>

    <!-- Every lever, what it is now, and a choice that starts at leave unchanged -->
    <ScrollViewer Grid.Row="2">
      <ItemsControl ItemsSource="{x:Bind ViewModel.Levers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AppLeverRowViewModel">
            <Grid Padding="0,5" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="200" />
              </Grid.ColumnDefinitions>

              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource RowPrimaryTextStyle}" />
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon Glyph="{x:Bind Current.Glyph}" FontSize="12"
                          Foreground="{x:Bind Current.Tone, Converter={StaticResource ToneBrush}}" />
                <TextBlock Text="{x:Bind Current.Label}" FontSize="12"
                           Foreground="{x:Bind Current.Tone, Converter={StaticResource ToneBrush}}" />
              </StackPanel>

              <TextBlock Grid.Column="2" Text="{x:Bind LastUsedText}" VerticalAlignment="Center"
                         Style="{StaticResource RowSecondaryTextStyle}" />

              <ComboBox Grid.Column="3" HorizontalAlignment="Stretch" Height="32"
                        IsEnabled="{x:Bind CanEdit}"
                        ItemsSource="{x:Bind Target.ChoicesWithUnchanged}"
                        SelectedItem="{x:Bind Target.SelectedChoice, Mode=TwoWay}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</ContentDialog>
