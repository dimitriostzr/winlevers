<ContentDialog
    x:Class="WinLevers.App.Views.PreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WinLevers.App.Views"
    Title="Preview changes"
    PrimaryButtonText="Apply"
    CloseButtonText="Cancel"
    DefaultButton="Close">

  <ContentDialog.Resources>
    <!-- The stock dialog caps its content at 548px, which clipped the combo
         column off the right edge. These are the lightweight styling keys the
         dialog template reads; raising them here affects this dialog only. -->
    <x:Double x:Key="ContentDialogMaxWidth">840</x:Double>
    <x:Double x:Key="ContentDialogMaxHeight">920</x:Double>
  </ContentDialog.Resources>

  <Grid Width="720" MaxHeight="560">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- The sentence that gates Apply -->
    <TextBlock x:Name="Summary" Style="{StaticResource SectionHeaderTextStyle}" TextWrapping="Wrap" />

    <InfoBar x:Name="SystemWarning" Grid.Row="1" Margin="0,10,0,0"
             IsOpen="False" IsClosable="False" Severity="Informational" />

    <ScrollViewer Grid.Row="2" Margin="0,12,0,0">
      <StackPanel Spacing="10">
        <!-- Individual ops, so "128 changes" can be checked rather than trusted -->
        <ItemsControl x:Name="OpList">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="views:PreviewRow">
              <Grid Padding="0,3" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="1">
                  <TextBlock Text="{x:Bind AppDisplayName}" Style="{StaticResource RowPrimaryTextStyle}" />
                  <TextBlock Text="{x:Bind Target}" Style="{StaticResource RowSecondaryTextStyle}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind Change}" VerticalAlignment="Center"
                           Style="{StaticResource RowSecondaryTextStyle}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Fail closed: a key whose shape this build does not understand is
             never written into, and the user is told which. -->
        <StackPanel x:Name="RefusedSection" Visibility="Collapsed" Spacing="4">
          <TextBlock Text="NOT TOUCHED" Style="{StaticResource TableHeaderTextStyle}" />
          <ItemsControl x:Name="RefusedList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="views:PreviewRow">
                <StackPanel Padding="0,3" Spacing="1">
                  <TextBlock Text="{x:Bind Target}" Style="{StaticResource RowPrimaryTextStyle}" />
                  <TextBlock Text="{x:Bind Change}" Style="{StaticResource RowSecondaryTextStyle}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</ContentDialog>
