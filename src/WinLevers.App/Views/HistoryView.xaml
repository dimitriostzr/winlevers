<UserControl
    x:Class="WinLevers.App.Views.HistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:WinLevers.App.Services"
    xmlns:vm="using:WinLevers.Presentation.ViewModels">

  <UserControl.Resources>
    <services:BoolToVisibilityConverter x:Key="BoolVisible" />
    <services:StringToVisibilityConverter x:Key="TextVisible" />
    <services:RowShadeToBrushConverter x:Key="ShadeBrush" />
  </UserControl.Resources>

  <Grid Padding="16,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="2">
        <TextBlock Text="History" Style="{StaticResource PageTitleTextStyle}" />
        <TextBlock Text="Every batch, with what it wrote and how to put it back."
                   Style="{StaticResource RowSecondaryTextStyle}" />
      </StackPanel>
      <Button Grid.Column="1" Content="Export batches…" Height="32" VerticalAlignment="Top"
              Click="ExportBatches_Click" />
    </Grid>

    <TextBlock Grid.Row="1" Text="Nothing has been applied yet."
               Style="{StaticResource RowSecondaryTextStyle}"
               Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolVisible}}" />

    <Grid Grid.Row="1"
          Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolVisible}, ConverterParameter=Invert}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Batches, newest first -->
      <ListView ItemsSource="{x:Bind ViewModel.Batches, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                SelectionMode="Single">
        <ListView.Resources>
          <!-- The stock feedback is a 6% tint that vanishes under the shades. -->
          <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="RowHoverBrush" />
          <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="RowPressedBrush" />
        </ListView.Resources>
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="vm:BatchRowViewModel">
            <StackPanel Spacing="1" Padding="10,6"
                        Background="{x:Bind Shade, Converter={StaticResource ShadeBrush}}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Bind When}" Style="{StaticResource RowPrimaryTextStyle}" />
                <TextBlock Text="{x:Bind Kind}" Style="{StaticResource RowSecondaryTextStyle}" />
                <Border Visibility="{x:Bind Note, Converter={StaticResource TextVisible}}"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="3" Padding="4,0" VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind Note}" FontSize="10"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
              </StackPanel>
              <TextBlock Text="{x:Bind Outcome}" Style="{StaticResource RowSecondaryTextStyle}" />
            </StackPanel>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <!-- The selected batch, drilled to individual writes -->
      <Grid Grid.Column="1" Padding="16,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
          <Button x:Name="RevertButton" Content="Put this batch back" Height="32" Click="Revert_Click"
                  IsEnabled="False" />
          <Button x:Name="ExportChangesButton" Content="Export changes…" Height="32"
                  Click="ExportChanges_Click" IsEnabled="False" />
          <TextBlock x:Name="RevertNote" Style="{StaticResource RowSecondaryTextStyle}"
                     VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Item click, as in AppsView: without it the rows draw no feedback. -->
        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Changes, Mode=OneWay}"
                  SelectionMode="None"
                  IsItemClickEnabled="True">
          <ListView.Resources>
            <!-- The stock feedback is a 6% tint that vanishes under the shades. -->
            <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="RowHoverBrush" />
            <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="RowPressedBrush" />
          </ListView.Resources>
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="MinHeight" Value="0" />
              <Setter Property="CornerRadius" Value="0" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:ChangeRowViewModel">
              <Grid ColumnSpacing="10" Padding="10,4"
                    Background="{x:Bind Shade, Converter={StaticResource ShadeBrush}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="1">
                  <TextBlock Text="{x:Bind AppDisplayName}" Style="{StaticResource RowPrimaryTextStyle}" />
                  <TextBlock Text="{x:Bind Target}" Style="{StaticResource RowSecondaryTextStyle}" />
                  <TextBlock Text="{x:Bind FailureReason}" FontSize="12"
                             Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                             TextWrapping="Wrap"
                             Visibility="{x:Bind FailureReason, Converter={StaticResource TextVisible}}" />
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                           Text="{x:Bind Transition}"
                           Style="{StaticResource RowSecondaryTextStyle}" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
